{
  "expo": {
    "name": "Live Interpreter",
    "slug": "live-interpreter-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EEE4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.liveinterpreter.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to capture on-screen text for translation.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to set your profile picture."
      }
    },
    "android": {
      "package": "com.liveinterpreter.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#F4EEE4"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "This app needs microphone access to capture speech for live interpretation."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/icon.png",
          "color": "#C1603A"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b08a2b14-b1a1-4174-a040-bef9d82298f5"
      }
    }
  }
}
