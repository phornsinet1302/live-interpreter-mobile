{
  "expo": {
    "name": "Live Interpreter",
    "slug": "live-interpreter-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1221"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.liveinterpreter.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs microphone access to capture speech for live interpretation."
      }
    },
    "android": {
      "package": "com.liveinterpreter.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#0B1221"
      },
      "permissions": ["RECORD_AUDIO", "INTERNET"]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": ["expo-av"],
    "extra": {
      "apiBaseUrl": "https://api.example.com"
    }
  }
}
