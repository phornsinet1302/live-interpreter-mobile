{
  "expo": {
    "name": "Live Interpreter",
    "slug": "live-interpreter-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EEE4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.liveinterpreter.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs microphone access to capture speech for live interpretation.",
        "NSCameraUsageDescription": "This app uses the camera to capture on-screen text for translation.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to set your profile picture."
      }
    },
    "android": {
      "package": "com.liveinterpreter.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#F4EEE4"
      },
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "CAMERA",
        "SYSTEM_ALERT_WINDOW",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-av",
      "expo-font",
      "expo-web-browser",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/icon.png",
          "color": "#C1603A"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.example.com",
      "googleClientId": ""
    }
  }
}
